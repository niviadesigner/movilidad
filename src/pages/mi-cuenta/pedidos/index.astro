---
import TiendaLayout from '../../../layouts/TiendaLayout.astro';
import Section from '../../../components/ui/Section.astro';
import MisPedidos from '../../../components/islands/MisPedidos.tsx';

const seo = {
  titulo: 'Mis pedidos',
  descripcion: 'Historial de pedidos y estado de cada envío.',
  ruta: '/mi-cuenta/pedidos',
  noIndex: true,
};
---

<TiendaLayout seo={seo}>
  <Section espaciado="amplio">
    <h1 class="text-[var(--text-4xl)]">Mis pedidos</h1>
    <div class="mt-6">
      <MisPedidos client:load />
    </div>
  </Section>
</TiendaLayout>
