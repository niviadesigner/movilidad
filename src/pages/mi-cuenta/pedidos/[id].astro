---
import TiendaLayout from '../../../layouts/TiendaLayout.astro';
import Section from '../../../components/ui/Section.astro';

/**
 * Detalle y rastreo de un pedido. Fase 0: una ruta de ejemplo.
 * En Fase 4 el estado del pedido sale de Supabase.
 */
export function getStaticPaths() {
  return [{ params: { id: 'ejemplo' } }];
}

const { id } = Astro.params;
const seo = {
  titulo: `Pedido ${id}`,
  descripcion: 'Detalle del pedido y estado del envío.',
  ruta: `/mi-cuenta/pedidos/${id}`,
  noIndex: true,
};
---

<TiendaLayout seo={seo} migasOverrides={{ [`/mi-cuenta/pedidos/${id}`]: `Pedido ${id}` }}>
  <Section espaciado="amplio">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Esqueleto navegable · se completa en Fase 4
    </p>
    <h1 class="mt-3 text-[var(--text-3xl)]">Pedido {id}</h1>
    <p class="mt-4 max-w-[52ch] text-[var(--color-text-muted)]">
      Aquí van el resumen del pedido, los productos, la dirección de envío y el rastreo con
      el estado en tiempo real.
    </p>
    <a class="mt-6 inline-block text-[var(--text-sm)] font-semibold hover:underline" href="/mi-cuenta/pedidos">
      &larr; Volver a mis pedidos
    </a>
  </Section>
</TiendaLayout>
