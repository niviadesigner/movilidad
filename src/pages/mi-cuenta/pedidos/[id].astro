---
import TiendaLayout from '../../../layouts/TiendaLayout.astro';
import Section from '../../../components/ui/Section.astro';
import DetallePedido from '../../../components/islands/DetallePedido.tsx';

// Los pedidos son locales al dispositivo (Fase 4). La ruta es fija ("detalle")
// y el número de pedido viaja en ?ref=. Con cuenta real esto pasará a SSR.
export function getStaticPaths() {
  return [{ params: { id: 'detalle' } }];
}

const seo = {
  titulo: 'Detalle del pedido',
  descripcion: 'Detalle del pedido y estado del envío.',
  ruta: '/mi-cuenta/pedidos/detalle',
  noIndex: true,
};
---

<TiendaLayout seo={seo} migasOverrides={{ '/mi-cuenta/pedidos/detalle': 'Detalle' }}>
  <Section espaciado="amplio">
    <h1 class="text-[var(--text-3xl)]">Detalle del pedido</h1>
    <div class="mt-8">
      <DetallePedido client:load />
    </div>
    <a href="/mi-cuenta/pedidos" class="mt-8 inline-block text-[var(--text-sm)] font-semibold hover:underline">
      &larr; Volver a mis pedidos
    </a>
  </Section>
</TiendaLayout>
