---
import TiendaLayout from '../../layouts/TiendaLayout.astro';
import Section from '../../components/ui/Section.astro';
import MisDirecciones from '../../components/islands/MisDirecciones.tsx';

const seo = {
  titulo: 'Mis direcciones',
  descripcion: 'Administra tus direcciones de envío guardadas.',
  ruta: '/mi-cuenta/direcciones',
  noIndex: true,
};
---

<TiendaLayout seo={seo}>
  <Section espaciado="amplio">
    <h1 class="text-[var(--text-4xl)]">Direcciones</h1>
    <div class="mt-6">
      <MisDirecciones client:load />
    </div>
  </Section>
</TiendaLayout>
