---
/**
 * HOME B2B — 11 bloques en el orden de docs/arquitectura-informacion.md §5.
 * Le habla primero a empresas y constructoras. La tienda entra por bloque, no por el hero.
 * Sin cifras ni nombres de clientes inventados: el dato duro del hero es la Ley 1811 (real
 * y citable); el caso destacado se conecta cuando exista uno verificable.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import CTA from '../components/ui/CTA.astro';
import LogoBar from '../components/ui/LogoBar.astro';
import Pasos from '../components/ui/Pasos.astro';
import FormularioCotizacion from '../components/ui/FormularioCotizacion.astro';
import { SEGMENTOS } from '../lib/nav';
import { whatsappUrl } from '../lib/site';
import type { NombreIcono } from '../components/ui/Icono.astro';

const ICONO_SEGMENTO: Record<string, NombreIcono> = {
  '/soluciones/empresas': 'maletin',
  '/soluciones/constructoras': 'compas',
  '/soluciones/conjuntos': 'casa',
  '/soluciones/universidades': 'graduacion',
};

const seo = {
  titulo: 'Soluciones de Movilidad — Infraestructura para movilidad en bicicleta',
  descripcion:
    'Biciparqueaderos para empresas, constructoras y conjuntos, mantenimiento de bicicletas y tienda de accesorios. Cotiza y un ingeniero te responde en menos de 24 h.',
  ruta: '/',
};

const pasosTrabajo = [
  { titulo: 'Nos cuentas', texto: 'Envías la solicitud con tu espacio y cuántos cupos calculas.' },
  { titulo: 'Visita técnica', texto: 'Un ingeniero mide en sitio y evalúa accesos, pisos y anclajes.' },
  { titulo: 'Propuesta', texto: 'Recibes modelo sugerido, distribución de cupos y valor estimado.' },
  { titulo: 'Instalación', texto: 'Fabricamos e instalamos, y entregamos con acta y garantía.' },
];
---

<SiteLayout seo={seo} sinMigas>
  {/* 1 · Hero — promesa amplia (no solo biciparqueaderos) + prueba de experiencia + CTA */}
  <Section fondo="subtle" espaciado="amplio">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,46rem)_1fr]">
      <div>
        <h1 class="text-[var(--text-5xl)]">Soluciones para movernos mejor</h1>
        <p class="mt-5 text-[var(--text-lg)] text-[var(--color-text-muted)]">
          Diseñamos, fabricamos e implementamos soluciones para bicicletas y movilidad
          sostenible, combinando experiencia técnica, funcionalidad y atención al detalle.
        </p>
        <p class="mt-2 text-[var(--text-base)] text-[var(--color-text-muted)]">
          Biciparqueaderos, bicitalleres, soportes para bicicletas y mantenimiento especializado.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <CTA href="/cotizar" variante="primario" tamano="lg">Cotizar un proyecto</CTA>
          <CTA href="/mantenimiento/agendar" variante="secundario">Solicitar mantenimiento</CTA>
        </div>
        <p class="mt-4 font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]">
          Experiencia en proyectos instalados en más de 25 ciudades de Colombia.
        </p>
      </div>
      <img
        src="/images/hero-home.jpg"
        alt="Biciparqueadero corporativo instalado en el acceso de un edificio de oficinas"
        width="1200"
        height="900"
        fetchpriority="high"
        decoding="async"
        class="hidden w-full rounded-[var(--radius-lg)] object-cover lg:block"
      />
    </div>
  </Section>

  {/* 2 · Tres líneas — qué hacemos, de un vistazo */}
  <Section espaciado="compacto">
    <h2 class="text-[var(--text-2xl)]">Nuestras líneas</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <Card href="/biciparqueaderos" titulo="Infraestructura para bicicletas" icono="edificio">
        Biciparqueaderos y bicitalleres para empresas, constructoras, conjuntos y espacio público.
      </Card>
      <Card href="/mantenimiento" titulo="Taller y mantenimiento" icono="herramienta">
        Mantenimiento en taller, a domicilio y protección de tu bicicleta.
      </Card>
      <Card href="/tienda" titulo="Productos para ciclistas" icono="carrito">
        Soportes, accesorios y equipamiento pensado por quienes montan bicicleta.
      </Card>
    </div>
  </Section>

  {/* 3 · Barra de logos de clientes (parte alta, regla §8) */}
  <Section espaciado="compacto">
    <LogoBar />
  </Section>

  {/* 4 · Selector de sector → /soluciones/* */}
  <Section fondo="subtle">
    <h2 class="text-[var(--text-2xl)]">¿Desde dónde nos escribes?</h2>
    <p class="mt-2 text-[var(--color-text-muted)]">Cada audiencia tiene su recorrido.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {SEGMENTOS.map((s) => (
        <Card href={s.href} titulo={s.label} icono={ICONO_SEGMENTO[s.href]}>Solución transversal para {s.label.toLowerCase()}.</Card>
      ))}
    </div>
  </Section>

  {/* 4 · Línea 1 · Biciparqueaderos — bloque grande, doble peso visual */}
  <Section espaciado="amplio">
    <div class="rounded-[var(--radius-lg)] border-2 border-[var(--color-primary-200)] bg-[var(--color-primary-50)] p-8 sm:p-12">
      <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-primary-700)]">
        Línea 1 · la que factura
      </p>
      <h2 class="mt-2 text-[var(--text-3xl)]">Biciparqueaderos</h2>
      <p class="mt-3 max-w-[54ch] text-[var(--color-text-muted)]">
        Proyecto B2B: se cotiza tras la decisión de un comité de RRHH, sostenibilidad y compras.
        Diseño de distribución, fabricación en acero e instalación llave en mano.
      </p>
      <ul class="mt-6 grid gap-x-8 gap-y-2 text-[var(--text-sm)] text-[var(--color-text-muted)] sm:grid-cols-2">
        <li>· Modelos para sótano, patio, fachada y espacio público</li>
        <li>· Distribución modular: empiezas con pocos cupos y amplías</li>
        <li>· Cumplimiento de Ley 1811 y PESV documentado por modelo</li>
        <li>· Ficha técnica en PDF de cada modelo</li>
      </ul>
      <div class="mt-8 flex flex-wrap gap-4">
        <CTA href="/biciparqueaderos" variante="primario" tamano="lg">Ver la línea</CTA>
        <CTA href="/biciparqueaderos/modelos" variante="texto">Comparar modelos</CTA>
      </div>
    </div>
  </Section>

  {/* 5 · Caso destacado — sin métricas inventadas: enlaza a proyectos verificables */}
  <Section fondo="subtle">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-[46ch]">
        <h2 class="text-[var(--text-2xl)]">Casos con métricas verificables</h2>
        <p class="mt-2 text-[var(--color-text-muted)]">
          Cada caso muestra cupos instalados, área recuperada y adopción, con la fuente del dato.
        </p>
      </div>
      <CTA href="/proyectos" variante="secundario">Ver proyectos</CTA>
    </div>
  </Section>

  {/* 6 · Bloque normativo → /recursos/normativa */}
  <Section>
    <h2 class="text-[var(--text-2xl)]">¿Estás obligado a tener biciparqueadero?</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-[var(--radius-md)] border border-[var(--color-border)] p-5">
        <p class="font-semibold">Ley 1811 de 2016</p>
        <p class="mt-1 text-[var(--text-sm)] text-[var(--color-text-muted)]">Promoción del uso de la bicicleta y estímulos para entidades y empresas.</p>
      </div>
      <div class="rounded-[var(--radius-md)] border border-[var(--color-border)] p-5">
        <p class="font-semibold">PESV</p>
        <p class="mt-1 text-[var(--text-sm)] text-[var(--color-text-muted)]">El Plan Estratégico de Seguridad Vial contempla infraestructura para modos activos.</p>
      </div>
      <div class="rounded-[var(--radius-md)] border border-[var(--color-border)] p-5">
        <p class="font-semibold">POT municipal</p>
        <p class="mt-1 text-[var(--text-sm)] text-[var(--color-text-muted)]">Los planes de ordenamiento fijan cupos mínimos de estacionamiento de bicicletas.</p>
      </div>
    </div>
    <div class="mt-6">
      <CTA href="/recursos/normativa" variante="secundario">Ver qué te aplica</CTA>
    </div>
  </Section>

  {/* 7 · Línea 2 · Mantenimiento — bloque medio, 3 modalidades, CTA Agendar */}
  <Section fondo="subtle">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">Línea 2 · servicio recurrente</p>
    <h2 class="mt-2 text-[var(--text-2xl)]">Mantenimiento de bicicletas</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <Card href="/mantenimiento/jornadas-empresariales" titulo="Jornadas en sede" icono="maletin">Llevamos el taller a tu empresa un día pactado.</Card>
      <Card href="/mantenimiento/taller" titulo="Taller" icono="herramienta">Dejas tu bici y la recoges lista.</Card>
      <Card href="/mantenimiento/domicilio" titulo="A domicilio" icono="camion">Un técnico va a tu casa, previa validación de cobertura.</Card>
    </div>
    <div class="mt-6">
      <CTA href="/mantenimiento/agendar" variante="primario">Agendar</CTA>
    </div>
  </Section>

  {/* 8 · Línea 3 · Tienda — bloque medio, categorías con precio público → /tienda */}
  <Section>
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">Línea 3 · ecommerce</p>
    <h2 class="mt-2 text-[var(--text-2xl)]">Tienda de accesorios</h2>
    <p class="mt-2 text-[var(--color-text-muted)]">Precio público, carrito y envío calculado antes de pagar.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <Card href="/tienda/soportes" titulo="Soportes" icono="bici">De pared, piso y techo.</Card>
      <Card href="/tienda/morrales-maletines" titulo="Morrales y maletines" icono="mochila">Impermeables y alforjas.</Card>
      <Card href="/tienda/seguridad" titulo="Seguridad" icono="candado">Guayas y candados de U.</Card>
      <Card href="/tienda/accesorios" titulo="Accesorios" icono="casco">Luces, timbres, guardabarros.</Card>
    </div>
    <div class="mt-6">
      <CTA href="/tienda" variante="secundario">Ir a la tienda</CTA>
    </div>
  </Section>

  {/* 9 · ¿Qué necesitas? — accesos directos por necesidad puntual */}
  <Section>
    <h2 class="text-[var(--text-2xl)]">¿Qué necesitas?</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      <CTA href="/biciparqueaderos" variante="secundario" class="justify-start">Tengo un proyecto de biciparqueaderos</CTA>
      <CTA href="/biciparqueaderos/bicitalleres" variante="secundario" class="justify-start">Necesito un bicitaller</CTA>
      <CTA href="/mantenimiento/agendar" variante="secundario" class="justify-start">Necesito mantenimiento para mi bicicleta</CTA>
      <CTA href="/mantenimiento/laminado-ppf" variante="secundario" class="justify-start">Quiero proteger mi bici con lámina PPF</CTA>
      <CTA href="/tienda/soportes" variante="secundario" class="justify-start">Busco soportes para mi bicicleta</CTA>
      <CTA href="/cotizar" variante="secundario" class="justify-start">Quiero cotizar un proyecto</CTA>
    </div>
  </Section>

  {/* 10 · Cómo trabajamos, en 4 pasos */}
  <Section fondo="subtle">
    <Pasos titulo="Cómo trabajamos" pasos={pasosTrabajo} />
  </Section>

  {/* 11 · Aliados y certificaciones */}
  <Section espaciado="compacto">
    <LogoBar titulo="Aliados y certificaciones" />
  </Section>

  {/* 12 · CTA final con formulario de 5 campos + WhatsApp */}
  <Section fondo="primario" espaciado="amplio">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="max-w-[42ch]">
        <h2 class="text-[var(--text-3xl)] text-[var(--color-text-inverse)]">
          Cuéntanos tu espacio y te devolvemos una propuesta
        </h2>
        <p class="mt-3 text-[var(--color-primary-100)]">
          Cinco campos, sin compromiso. Un ingeniero te responde en menos de 24 h.
        </p>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block text-[var(--text-sm)] font-semibold text-[var(--color-accent-300)] underline underline-offset-4"
        >
          O escríbenos directo por WhatsApp
        </a>
      </div>
      <div class="rounded-[var(--radius-lg)] bg-[var(--color-surface)] p-6 sm:p-8">
        <FormularioCotizacion origen="/" idPrefijo="home" />
      </div>
    </div>
  </Section>
</SiteLayout>
