---
/**
 * HOME B2B. Le habla primero a empresas y constructoras.
 * El orden real de los 11 bloques se arma en Fase 2 (docs/plan §Fase 2).
 * Aquí: esqueleto con las tres líneas y su peso visual relativo.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import CTA from '../components/ui/CTA.astro';
import LogoBar from '../components/ui/LogoBar.astro';
import { SEGMENTOS } from '../lib/nav';

const seo = {
  titulo: 'Soluciones de Movilidad — Infraestructura para movilidad en bicicleta',
  descripcion:
    'Biciparqueaderos para empresas y constructoras, mantenimiento de bicicletas y tienda de accesorios. Cotiza tu proyecto y un ingeniero te responde en menos de 24 h.',
  ruta: '/',
};
---

<SiteLayout seo={seo} sinMigas>
  <!-- 1 · Hero -->
  <Section fondo="subtle" espaciado="amplio">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Esqueleto navegable · la home se arma en Fase 2
    </p>
    <h1 class="mt-3 max-w-[20ch] text-[var(--text-5xl)]">
      Infraestructura para que tu equipo llegue en bici
    </h1>
    <p class="mt-5 max-w-[52ch] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      {/* TODO: reemplazar con dato duro real + promesa (regla §8). */}
      Diseñamos, instalamos y mantenemos biciparqueaderos para empresas, constructoras y
      conjuntos. Cifra de respaldo pendiente de fuente verificable.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <CTA href="/cotizar" variante="primario" tamano="lg">Cotizar en 24 h</CTA>
      <CTA href="/recursos/calculadora-cupos" variante="secundario">Calcular cupos</CTA>
    </div>
  </Section>

  <!-- 2 · Logos de clientes (parte alta, regla §8) -->
  <Section espaciado="compacto">
    <LogoBar />
  </Section>

  <!-- 3 · Selector de sector -->
  <Section fondo="subtle">
    <h2 class="text-[var(--text-2xl)]">¿Desde dónde nos escribes?</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {SEGMENTOS.map((s) => (
        <Card href={s.href} titulo={s.label}>
          Ruta transversal para {s.label.toLowerCase()}.
        </Card>
      ))}
    </div>
  </Section>

  <!-- 4 · Línea 1 · Biciparqueaderos (doble peso visual) -->
  <Section>
    <div class="rounded-[var(--radius-lg)] border-2 border-[var(--color-primary-200)] bg-[var(--color-primary-50)] p-8 sm:p-12">
      <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-primary-700)]">
        Línea 1 · la que factura
      </p>
      <h2 class="mt-2 text-[var(--text-3xl)]">Biciparqueaderos</h2>
      <p class="mt-3 max-w-[54ch] text-[var(--color-text-muted)]">
        Proyecto B2B de ticket alto. Decisión por comité: RRHH, sostenibilidad y compras.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <CTA href="/biciparqueaderos" variante="primario">Ver la línea</CTA>
        <CTA href="/biciparqueaderos/modelos" variante="texto">Ver modelos</CTA>
      </div>
    </div>
  </Section>

  <!-- 7 · Línea 2 · Mantenimiento / 8 · Línea 3 · Tienda (peso medio) -->
  <Section fondo="subtle">
    <div class="grid gap-6 lg:grid-cols-2">
      <Card titulo="Mantenimiento" href="/mantenimiento" eyebrow="Línea 2 · servicio recurrente">
        Jornadas en sede, taller propio y a domicilio. Cierra con agendamiento.
      </Card>
      <Card titulo="Tienda" href="/tienda" eyebrow="Línea 3 · ecommerce">
        Soportes, morrales, guayas y accesorios con precio público y carrito.
      </Card>
    </div>
  </Section>

  <!-- Bloques 5, 6, 9, 10, 11 se agregan en Fase 2 -->
  <Section>
    <p class="text-[var(--text-sm)] text-[var(--color-text-muted)]">
      Pendientes para Fase 2: caso destacado con métricas, bloque normativo,
      cómo trabajamos, aliados y certificaciones, y el formulario final de 5 campos.
    </p>
  </Section>
</SiteLayout>
