---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import CapturaCorreo from '../../components/ui/CapturaCorreo.astro';

const seo = {
  titulo: 'Fichas técnicas de biciparqueaderos',
  descripcion:
    'Descarga en PDF las dimensiones, materiales y normativa que cumple cada modelo de biciparqueadero.',
  ruta: '/recursos/fichas-tecnicas',
};

const modelos = (await getCollection('modelos'))
  .filter((m) => import.meta.env.DEV || !m.data.borrador)
  .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre));
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      Recursos · Fichas técnicas
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Fichas técnicas descargables</h1>
    <p class="mt-4 max-w-[46rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Cada ficha trae dimensiones, materiales, capacidad de cupos y la normativa que cumple el
      modelo. Te la enviamos al correo.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {modelos.map((m) => (
        <div>
          <a href={`/biciparqueaderos/modelos/${m.id}`} class="font-display text-[var(--text-lg)] font-bold hover:underline">
            {m.data.nombre}
          </a>
          <p class="mt-1 font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]">
            {m.data.codigo} · {m.data.cupos} cupos
          </p>
          <div class="mt-3">
            <CapturaCorreo modeloId={m.id} modeloNombre={m.data.nombre} pdfUrl={m.data.fichaPdf} />
          </div>
        </div>
      ))}
      {modelos.length === 0 && (
        <p class="text-[var(--text-sm)] text-[var(--color-text-muted)]">Aún no hay fichas publicadas.</p>
      )}
    </div>
  </Section>
</SiteLayout>
