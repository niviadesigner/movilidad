---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import CalculadoraCupos from '../../components/islands/CalculadoraCupos.tsx';

const seo = {
  titulo: 'Calculadora de cupos de biciparqueadero',
  descripcion:
    'Estima cuántos cupos de biciparqueadero necesitas según el tipo de espacio y el número de personas.',
  ruta: '/recursos/calculadora-cupos',
};
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      Recursos · Calculadora
    </p>
    <h1 class="mt-3 max-w-[26ch] text-[var(--text-4xl)]">¿Cuántos cupos necesitas?</h1>
    <p class="mt-4 max-w-[46rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Elige el tipo de espacio y cuántas personas o unidades tiene. Te damos un rango para
      planear el proyecto en segundos.
    </p>

    <div class="mt-10 max-w-[40rem]">
      <CalculadoraCupos client:load />
    </div>

    <p class="mt-8 max-w-[40rem] text-[var(--text-sm)] text-[var(--color-text-muted)]">
      Esta calculadora da un estimado de planeación, no la cifra oficial que exige el POT de tu
      municipio. Revisa qué normas te aplican en
      <a class="underline" href="/recursos/normativa">Normativa</a>.
    </p>
  </Section>
</SiteLayout>
