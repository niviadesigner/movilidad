---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import CTA from '../../components/ui/CTA.astro';
import FAQ from '../../components/ui/FAQ.astro';
import { NORMAS, FAQ_NORMATIVA } from '../../data/normativa';

const seo = {
  titulo: 'Normativa de biciparqueaderos en Colombia: Ley 1811, PESV y POT',
  descripcion:
    'Qué exigen la Ley 1811 de 2016, el PESV y el POT de tu municipio en materia de biciparqueaderos, explicado sin rodeos.',
  ruta: '/recursos/normativa',
};
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      Recursos · Normativa
    </p>
    <h1 class="mt-3 max-w-[26ch] text-[var(--text-4xl)]">
      ¿Tu empresa o tu proyecto está obligado a tener biciparqueadero?
    </h1>
    <p class="mt-4 max-w-[52rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Tres normas suelen entrar en juego: la Ley 1811, el PESV y el POT de tu municipio. Cada
      una aplica distinto según si eres empresa, entidad o proyecto de construcción.
    </p>
    <p class="mt-4 max-w-[46rem] font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]">
      Contenido informativo, no es asesoría legal. Para tu caso puntual, cotiza y lo revisamos contigo.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <CTA href="/cotizar" variante="primario" tamano="lg">Cotizar y resolver mi caso</CTA>
      <CTA href="/recursos/calculadora-cupos" variante="secundario">Calcular cupos</CTA>
    </div>
  </Section>

  <Section fondo="subtle">
    <div class="grid gap-6">
      {NORMAS.map((n) => (
        <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="font-display text-[var(--text-xl)] font-bold">{n.norma}</h2>
            <p class="font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]">{n.vigencia}</p>
          </div>
          <p class="mt-3 text-[var(--color-text-muted)]">{n.resumen}</p>
          <dl class="mt-4 grid gap-3 sm:grid-cols-2">
            <div>
              <dt class="font-mono text-[var(--text-xs)] uppercase text-[var(--color-text-muted)]">A quién aplica</dt>
              <dd class="mt-0.5 text-[var(--text-sm)]">{n.aplicaA}</dd>
            </div>
            <div>
              <dt class="font-mono text-[var(--text-xs)] uppercase text-[var(--color-text-muted)]">Punto clave</dt>
              <dd class="mt-0.5 text-[var(--text-sm)]">{n.puntoClave}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <FAQ titulo="Preguntas frecuentes sobre la normativa" items={FAQ_NORMATIVA} schema />
  </Section>

  <Section fondo="primario" espaciado="amplio">
    <div class="max-w-[42rem]">
      <h2 class="text-[var(--text-3xl)] text-[var(--color-text-inverse)]">
        Te confirmamos si te aplica y cuántos cupos necesitas
      </h2>
      <p class="mt-3 text-[var(--color-primary-100)]">
        Cuéntanos tu caso: tipo de entidad, número de personas y municipio. Un ingeniero te
        responde en menos de 24 h.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <CTA href="/cotizar" variante="primario" tamano="lg">Cotizar en 24 h</CTA>
        <CTA href="/recursos/calculadora-cupos" variante="texto">
          <span class="text-[var(--color-primary-100)] underline">O calcula tus cupos primero</span>
        </CTA>
      </div>
    </div>
  </Section>
</SiteLayout>
