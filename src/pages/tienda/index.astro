---
import TiendaLayout from '../../layouts/TiendaLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import TarjetaProducto from '../../components/tienda/TarjetaProducto.astro';
import { CATEGORIAS, getDestacados } from '../../lib/tienda';
import { UMBRAL_ENVIO_GRATIS } from '../../lib/envios';
import { formatoCOP } from '../../lib/pricing';

const seo = {
  titulo: 'Tienda de accesorios para bicicleta',
  descripcion:
    'Soportes, morrales, guayas, candados y accesorios para tu bicicleta. Precio público, envío calculado antes del pago y compra sin registro.',
  ruta: '/tienda',
};

const destacados = await getDestacados(4);
---

<TiendaLayout seo={seo}>
  <Section espaciado="amplio">
    <h1 class="text-[var(--text-4xl)]">Tienda</h1>
    <p class="mt-4 max-w-[52rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Todo para moverte y dejar la bici segura. Precio público, compra como invitado y
      envío gratis desde {formatoCOP(UMBRAL_ENVIO_GRATIS)}.
    </p>

    <h2 class="mt-12 font-display text-[var(--text-2xl)] font-bold">Destacados</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {destacados.map((p) => <TarjetaProducto producto={p} />)}
    </div>

    <h2 class="mt-14 font-display text-[var(--text-2xl)] font-bold">Categorías</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {CATEGORIAS.map((c) => (
        <Card href={`/tienda/${c.slug}`} titulo={c.nombre}>{c.descripcion}</Card>
      ))}
      <Card href="/tienda/corporativo" titulo="Compra por volumen" eyebrow="B2B">
        Descuento por cantidad con el mismo motor de precios que la cotización.
      </Card>
      <Card href="/tienda/ofertas" titulo="Ofertas" eyebrow="Descuentos">
        Productos con precio anterior real y verificable.
      </Card>
    </div>

    <nav aria-label="Ayuda de la tienda" class="mt-12 border-t border-[var(--color-border)] pt-6 text-[var(--text-sm)]">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a class="hover:underline" href="/tienda/envios">Envíos y entregas</a></li>
        <li><a class="hover:underline" href="/tienda/devoluciones">Cambios y devoluciones</a></li>
        <li><a class="hover:underline" href="/tienda/garantia">Garantía</a></li>
        <li><a class="hover:underline" href="/tienda/buscar">Buscador</a></li>
      </ul>
    </nav>
  </Section>
</TiendaLayout>
