---
import TiendaLayout from '../../layouts/TiendaLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import { NAV_TIENDA } from '../../lib/nav';

const seo = {
  titulo: 'Tienda de accesorios para bicicleta',
  descripcion:
    'Soportes, morrales, guayas, candados y accesorios para tu bicicleta. Precio público, envío calculado antes del pago y compra sin registro.',
  ruta: '/tienda',
};
---

<TiendaLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Esqueleto navegable · el catálogo y el carrito llegan en Fase 4
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Tienda</h1>
    <p class="mt-4 max-w-[52ch] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Ecommerce con carrito y precio público. Checkout de invitado, costo de envío calculado
      antes de pagar y pasarela Wompi.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {NAV_TIENDA.map((c) => (
        <Card href={c.href} titulo={c.label}>Categoría de la tienda.</Card>
      ))}
      <Card href="/tienda/corporativo" titulo="Compra por volumen" eyebrow="B2B">
        Descuento por volumen visible, con el mismo motor de precios que la cotización.
      </Card>
    </div>

    <nav aria-label="Ayuda de la tienda" class="mt-12 border-t border-[var(--color-border)] pt-6 text-[var(--text-sm)]">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a class="hover:underline" href="/tienda/envios">Envíos y entregas</a></li>
        <li><a class="hover:underline" href="/tienda/devoluciones">Cambios y devoluciones</a></li>
        <li><a class="hover:underline" href="/tienda/garantia">Garantía</a></li>
        <li><a class="hover:underline" href="/tienda/buscar">Buscador</a></li>
      </ul>
    </nav>
  </Section>
</TiendaLayout>
