---
import TiendaLayout from '../../layouts/TiendaLayout.astro';
import Section from '../../components/ui/Section.astro';
import PaginaCarrito from '../../components/islands/PaginaCarrito.tsx';

const seo = {
  titulo: 'Carrito',
  descripcion: 'Revisa los productos que vas a comprar antes de pasar al pago.',
  ruta: '/tienda/carrito',
  noIndex: true,
};
---

<TiendaLayout seo={seo}>
  <Section espaciado="amplio">
    <h1 class="text-[var(--text-4xl)]">Tu carrito</h1>
    <div class="mt-8">
      <PaginaCarrito client:load />
    </div>
  </Section>
</TiendaLayout>
