---
import TiendaLayout from '../../layouts/TiendaLayout.astro';
import GrillaCategoria from '../../components/tienda/GrillaCategoria.astro';

const seo = {
  titulo: 'Soportes para bicicleta',
  descripcion:
    'Soportes de pared, piso y techo para guardar la bicicleta en casa u oficina. Precio y disponibilidad visibles.',
  ruta: '/tienda/soportes',
