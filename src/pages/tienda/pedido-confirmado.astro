---
import TiendaLayout from '../../layouts/TiendaLayout.astro';
import Section from '../../components/ui/Section.astro';
import CTA from '../../components/ui/CTA.astro';
import DetallePedido from '../../components/islands/DetallePedido.tsx';

const seo = {
  titulo: 'Pedido confirmado',
  descripcion: 'Tu pedido quedó registrado. Te enviamos el comprobante y el rastreo por correo.',
  ruta: '/tienda/pedido-confirmado',
  noIndex: true,
};

// Página estática: no se puede leer ?ref= en el servidor. El número de
// pedido lo muestra <DetallePedido> (lee la URL en el cliente); aquí basta
// con un texto genérico para no duplicar esa lectura.
---

<TiendaLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-primary-700)]">
      Pedido confirmado
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Gracias por tu compra</h1>
    <p class="mt-4 max-w-[52rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Te enviamos el comprobante al correo. Aquí está el resumen de tu pedido.
    </p>

    <div class="mt-10">
      <DetallePedido client:load />
    </div>

    <nav aria-label="Continuar" class="mt-10 flex flex-wrap gap-4">
      <CTA href="/tienda" variante="secundario">Seguir comprando</CTA>
      <CTA href="/mi-cuenta/pedidos" variante="texto">Ver mis pedidos</CTA>
    </nav>
  </Section>
</TiendaLayout>

<script>
  import { trackEvent, EVENTOS } from '../../lib/analytics';

  interface PedidoLocal {
    ref: string;
    total: number;
    modo?: string;
  }

  const ref = new URLSearchParams(location.search).get('ref') || '';
  try {
    const pedidos: PedidoLocal[] = JSON.parse(localStorage.getItem('pedidos') || '[]');
    const pedido = pedidos.find((p) => p.ref === ref);
    if (pedido) {
      trackEvent(EVENTOS.pedidoConfirmado, {
        value: pedido.total,
        currency: 'COP',
        transaction_id: pedido.ref,
        modo_pago: pedido.modo ?? 'demo',
      });
    }
  } catch {
    /* sin analítica si el pedido no se pudo leer */
  }
</script>
