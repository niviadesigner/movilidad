---
import TiendaLayout from '../../layouts/TiendaLayout.astro';
import Section from '../../components/ui/Section.astro';
import Checkout from '../../components/islands/Checkout.tsx';
import { pagoConfigurado } from '../../lib/pago';

const seo = {
  titulo: 'Checkout',
  descripcion: 'Finaliza tu compra. Sin registro obligatorio y con el costo de envío calculado antes de pagar.',
  ruta: '/tienda/checkout',
  noIndex: true,
};
---

<TiendaLayout seo={seo}>
  <Section espaciado="amplio">
    <h1 class="text-[var(--text-4xl)]">Checkout</h1>
    {!pagoConfigurado && (
      <p class="mt-3 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-4 py-3 text-[var(--text-sm)] text-[var(--color-text-muted)]">
        Modo demo: sin llaves de Wompi configuradas, el pedido se registra como prueba y no se cobra.
      </p>
    )}
    <div class="mt-8">
      <Checkout client:load />
    </div>
  </Section>
</TiendaLayout>
