---
import TiendaLayout from '../../../layouts/TiendaLayout.astro';
import Section from '../../../components/ui/Section.astro';
import CTA from '../../../components/ui/CTA.astro';

/**
 * Ficha de producto (Plantilla B). Fase 0: sin catálogo real.
 * Se genera una única ruta de ejemplo para poder ver la plantilla.
 * En Fase 4 las rutas salen del catálogo en Supabase.
 */
export function getStaticPaths() {
  return [
    {
      params: { categoria: 'seguridad', producto: 'ejemplo' },
      props: {
        nombre: 'Producto de ejemplo',
        categoriaLabel: 'Seguridad: guayas y candados',
        categoriaHref: '/tienda/seguridad',
      },
    },
  ];
}

const { nombre, categoriaLabel, categoriaHref } = Astro.props;
const { categoria, producto } = Astro.params;

const seo = {
  titulo: `${nombre}`,
  descripcion: 'Ficha de producto de ejemplo para validar la plantilla. Sin catálogo real todavía.',
  ruta: `/tienda/${categoria}/${producto}`,
  noIndex: true,
  tipo: 'product' as const,
};
---

<TiendaLayout
  seo={seo}
  migasOverrides={{
    [categoriaHref]: categoriaLabel,
    [`/tienda/${categoria}/${producto}`]: nombre,
  }}
>
  <Section espaciado="amplio">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Plantilla B — Ficha de producto · se completa en Fase 4
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">{nombre}</h1>
    <p class="mt-4 max-w-[52ch] text-[var(--color-text-muted)]">
      Aquí van: galería, precio con descuento por volumen visible, specs, garantía,
      certificaciones y productos relacionados. El precio sale del motor de precios único.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <CTA href="/tienda/carrito" variante="primario" tamano="lg">Agregar al carrito</CTA>
      <CTA href={categoriaHref} variante="secundario">Volver a {categoriaLabel}</CTA>
    </div>

    <nav aria-label="Venta cruzada" class="mt-14 border-t border-[var(--color-border)] pt-8 text-[var(--text-sm)]">
      <p class="text-[var(--color-text-muted)]">
        Cada ficha de seguridad enlaza a biciparqueaderos con un bloque de venta cruzada:
      </p>
      <a class="mt-2 inline-block font-semibold hover:underline" href="/biciparqueaderos">
        ¿Necesitas un biciparqueadero en tu edificio? &rarr;
      </a>
    </nav>
  </Section>
</TiendaLayout>
