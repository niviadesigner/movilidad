---
import { getCollection, render } from 'astro:content';
import TiendaLayout from '../../../layouts/TiendaLayout.astro';
import FichaProducto from '../../../components/plantillas/FichaProducto.astro';
import { categoriaMeta } from '../../../lib/tienda';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((p) => {
    const relacionados = productos
      .filter((x) => x.data.categoria === p.data.categoria && x.id !== p.id)
      .slice(0, 4);
    return {
      params: { categoria: p.data.categoria, producto: p.id },
      props: { producto: p, relacionados },
    };
  });
}

const { producto, relacionados } = Astro.props;
const { Content } = await render(producto);
const d = producto.data;
const cat = categoriaMeta(d.categoria);

const seo = {
  titulo: `${d.nombre}`,
  descripcion: d.resumen,
  ruta: `/tienda/${d.categoria}/${producto.id}`,
  noIndex: d.borrador,
  tipo: 'product' as const,
};
---

<TiendaLayout
  seo={seo}
  migasOverrides={{
    [`/tienda/${d.categoria}`]: cat?.nombre ?? d.categoria,
    [`/tienda/${d.categoria}/${producto.id}`]: d.nombre,
  }}
>
  <FichaProducto producto={producto} relacionados={relacionados}>
    <div class="prose mt-10 max-w-[42rem] text-[var(--color-text-muted)]">
      <Content />
    </div>
  </FichaProducto>
</TiendaLayout>
