---
import TiendaLayout from '../../layouts/TiendaLayout.astro';
import Section from '../../components/ui/Section.astro';
import BuscadorTienda from '../../components/islands/BuscadorTienda.tsx';
import { CATEGORIAS, getProductos, categoriaMeta, rutaProducto } from '../../lib/tienda';

const seo = {
  titulo: 'Buscar en la tienda',
  descripcion: 'Encuentra soportes, morrales, guayas, candados y accesorios para tu bicicleta.',
  ruta: '/tienda/buscar',
  noIndex: true,
};

const q = Astro.url.searchParams.get('q') ?? '';

const catalogo = (await getProductos()).map((p) => ({
  id: p.id,
  nombre: p.data.nombre,
  sku: p.data.sku,
  categoria: p.data.categoria,
  categoriaNombre: categoriaMeta(p.data.categoria)?.nombre ?? p.data.categoria,
  precio: p.data.precio,
  precioAntes: p.data.precioAntes,
  stock: p.data.stock,
  resumen: p.data.resumen,
  ruta: rutaProducto(p),
  imagen: p.data.imagenes[0],
}));
---

<TiendaLayout seo={seo}>
  <Section espaciado="amplio">
    <h1 class="text-[var(--text-3xl)]">Buscar en la tienda</h1>
    <div class="mt-8">
      <BuscadorTienda
        client:load
        catalogo={catalogo}
        categorias={CATEGORIAS.map((c) => ({ slug: c.slug, nombre: c.nombre }))}
        consultaInicial={q}
      />
    </div>
  </Section>
</TiendaLayout>
