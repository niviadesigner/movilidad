---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ServicioAgendable from '../../components/plantillas/ServicioAgendable.astro';
import { SERVICIOS } from '../../data/mantenimiento';

const seo = {
  titulo: 'Jornadas de mantenimiento en la sede de tu empresa',
  descripcion:
    'Llevamos el taller a tu sede: jornadas de mantenimiento de bicicletas para colaboradores, con reporte por unidad.',
  ruta: '/mantenimiento/jornadas-empresariales',
};
---

<SiteLayout seo={seo}>
  <ServicioAgendable contenido={SERVICIOS['jornadas-empresariales']} />
</SiteLayout>
