---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ServicioAgendable from '../../components/plantillas/ServicioAgendable.astro';
import { SERVICIOS } from '../../data/mantenimiento';

const seo = {
  titulo: 'Mantenimiento de bicicletas a domicilio',
  descripcion:
    'Un técnico va a tu casa. Primero validamos cobertura por barrio o localidad; solo después pedimos tus datos.',
  ruta: '/mantenimiento/domicilio',
};
---

<SiteLayout seo={seo}>
  <ServicioAgendable contenido={SERVICIOS.domicilio} />
</SiteLayout>
