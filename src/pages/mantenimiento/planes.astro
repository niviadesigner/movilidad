---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import CTA from '../../components/ui/CTA.astro';
import { PLANES, PLANES_DESC, PLANES_FILAS } from '../../data/mantenimiento';

const seo = {
  titulo: 'Planes y precios de mantenimiento',
  descripcion:
    'Compara los planes de mantenimiento de bicicletas: qué incluye cada uno, frecuencia y modalidad.',
  ruta: '/mantenimiento/planes',
};
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      Mantenimiento · Planes
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Planes y precios</h1>
    <p class="mt-4 max-w-[46rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Tres formas de contratar el mantenimiento. Los repuestos se cotizan aparte, siempre con
      tu autorización previa.
    </p>
    <p class="mt-2 font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]">
      Precios pendientes de definir con el cliente.
    </p>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[44rem] border-collapse text-[var(--text-sm)]">
        <thead>
          <tr>
            <th class="w-1/3 py-3 pr-4 text-left align-bottom font-mono text-[var(--text-xs)] uppercase text-[var(--color-text-muted)]">
              Característica
            </th>
            {PLANES.map((p) => (
              <th class="border-b-2 border-[var(--color-primary-600)] px-3 py-3 text-left align-bottom">
                <span class="block font-display text-[var(--text-base)] font-bold">{p}</span>
                <span class="block text-[var(--text-xs)] font-normal text-[var(--color-text-muted)]">{PLANES_DESC[p]}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {PLANES_FILAS.map((fila) => (
            <tr class="border-b border-[var(--color-border)]">
              <th scope="row" class="py-3 pr-4 text-left font-medium text-[var(--color-text)]">{fila.caracteristica}</th>
              {fila.valores.map((v) => (
                <td class="px-3 py-3 text-[var(--color-text-muted)]">
                  {typeof v === 'boolean' ? (
                    v ? <span class="font-semibold text-[var(--color-primary-600)]" aria-label="incluido">Sí</span> : <span aria-label="no incluido">—</span>
                  ) : (
                    v
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-12 flex flex-wrap gap-4">
      <CTA href="/mantenimiento/agendar" variante="primario" tamano="lg">Agendar ahora</CTA>
      <CTA href="/cotizar" variante="secundario">Cotizar plan de flota</CTA>
    </div>
  </Section>
</SiteLayout>
