---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ServicioAgendable from '../../components/plantillas/ServicioAgendable.astro';
import { SERVICIOS } from '../../data/mantenimiento';

const seo = {
  titulo: 'Planes de mantenimiento para flotas de bicicletas',
  descripcion:
    'Planes recurrentes de mantenimiento para flotas corporativas y de última milla, con tablero de estado por bicicleta.',
  ruta: '/mantenimiento/flotas',
};
---

<SiteLayout seo={seo}>
  <ServicioAgendable contenido={SERVICIOS.flotas} />
</SiteLayout>
