---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { HUB } from '../../data/mantenimiento';

const seo = {
  titulo: 'Mantenimiento de bicicletas para empresas y personas',
  descripcion:
    'Mantenimiento de bicicletas en tres modalidades: jornadas en sede, taller propio y a domicilio. Agenda en línea y confirma en el momento.',
  ruta: '/mantenimiento',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...HUB} />
</SiteLayout>
