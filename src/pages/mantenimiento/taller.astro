---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ServicioAgendable from '../../components/plantillas/ServicioAgendable.astro';
import { SERVICIOS } from '../../data/mantenimiento';

const seo = {
  titulo: 'Taller de mantenimiento de bicicletas',
  descripcion:
    'Lleva tu bicicleta a nuestro taller: diagnóstico, alistamiento y reparación con repuestos autorizados por ti.',
  ruta: '/mantenimiento/taller',
};
---

<SiteLayout seo={seo}>
  <ServicioAgendable contenido={SERVICIOS.taller} />
</SiteLayout>
