---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Section from '../../../components/ui/Section.astro';
import Card from '../../../components/ui/Card.astro';

const seo = {
  titulo: 'Agendar mantenimiento',
  descripcion:
    'Elige dónde necesitas el servicio: en tu empresa, en nuestro taller o en tu casa. Cada ruta pide datos distintos.',
  ruta: '/mantenimiento/agendar',
};

// El agendador real (4 pasos, validación de cobertura previa) se construye en Fase 3.
const rutas = [
  {
    titulo: 'En mi empresa',
    desc: 'Jornada en la sede. Pediremos número de bicis, fecha tentativa y ciudad.',
    href: '/mantenimiento/jornadas-empresariales',
  },
  {
    titulo: 'En su taller',
    desc: 'Cita en el taller propio. Pediremos tipo de servicio, fecha y hora.',
    href: '/mantenimiento/taller',
  },
  {
    titulo: 'En mi casa',
    desc: 'A domicilio. Primero validamos cobertura por barrio o código postal.',
    href: '/mantenimiento/domicilio',
  },
];
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Esqueleto navegable · el agendador de 4 pasos se construye en Fase 3
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">¿Dónde necesitas el servicio?</h1>
    <p class="mt-4 max-w-[52ch] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      El selector de modalidad va primero porque cada ruta pide datos distintos. Un formulario
      único con campos que aparecen y desaparecen genera abandono.
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {rutas.map((r) => (
        <Card href={r.href} titulo={r.titulo}>{r.desc}</Card>
      ))}
    </div>
  </Section>
</SiteLayout>
