---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Section from '../../../components/ui/Section.astro';
import Agendador from '../../../components/islands/Agendador.tsx';
import { SITE, whatsappUrl } from '../../../lib/site';

const seo = {
  titulo: 'Agendar mantenimiento',
  descripcion:
    'Elige dónde necesitas el servicio: en tu empresa, en nuestro taller o en tu casa. Cada ruta pide datos distintos.',
  ruta: '/mantenimiento/agendar',
};

// La modalidad de ?m= la lee el agendador en el cliente (esta página es estática).
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio" ancho="estrecho">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      Mantenimiento · Agendar
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Agenda tu mantenimiento</h1>
    <p class="mt-4 text-[var(--text-lg)] text-[var(--color-text-muted)]">
      El selector va primero porque cada modalidad pide datos distintos. Toma un par de minutos.
    </p>

    <div class="mt-10">
      <Agendador
        client:load
        tel={SITE.tel}
        whatsappHref={whatsappUrl('mantenimiento')}
      />
      <noscript>
        <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] p-6 text-[var(--text-sm)]">
          <p class="font-semibold">El agendador necesita JavaScript.</p>
          <p class="mt-2 text-[var(--color-text-muted)]">
            Mientras tanto: para <strong>jornadas en sede o flotas</strong>, usa el
            <a class="underline" href="/cotizar"> formulario de cotización</a>. Para
            <strong> taller o domicilio</strong>, llámanos al {SITE.tel} o escríbenos por
            <a class="underline" href={whatsappUrl('mantenimiento')} target="_blank" rel="noopener noreferrer"> WhatsApp</a>.
          </p>
        </div>
      </noscript>
    </div>
  </Section>
</SiteLayout>
