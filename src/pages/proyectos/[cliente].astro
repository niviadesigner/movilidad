---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import CasoEstudio from '../../components/plantillas/CasoEstudio.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { cliente: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const d = proyecto.data;

// Enlazado interno obligatorio: cada caso enlaza a los modelos que usa (docs/arquitectura §8).
const modelos = await getCollection('modelos');
const modelosUsados = d.modelosUsados
  .map((id) => modelos.find((m) => m.id === id))
  .filter((m): m is NonNullable<typeof m> => Boolean(m))
  .map((m) => ({ id: m.id, nombre: m.data.nombre }));

const seo = {
  titulo: `${d.cliente} — caso de estudio`,
  descripcion: d.reto,
  ruta: `/proyectos/${proyecto.id}`,
  noIndex: d.borrador,
  tipo: 'article' as const,
};
---

<SiteLayout seo={seo} migasOverrides={{ [`/proyectos/${proyecto.id}`]: d.cliente }}>
  <Section espaciado="amplio">
    <CasoEstudio
      cliente={d.cliente}
      sector={d.sector}
      ciudad={d.ciudad}
      reto={d.reto}
      solucion={d.solucion}
      metricas={d.metricas}
      testimonio={d.testimonio}
      galeria={d.galeria}
      modelosUsados={modelosUsados}
    >
      <Content />
    </CasoEstudio>
  </Section>
</SiteLayout>
