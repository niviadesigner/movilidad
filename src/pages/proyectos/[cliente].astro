---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import CTA from '../../components/ui/CTA.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { cliente: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const d = proyecto.data;

const seo = {
  titulo: `${d.cliente} — caso de estudio`,
  descripcion: d.reto,
  ruta: `/proyectos/${proyecto.id}`,
  noIndex: d.borrador,
  tipo: 'article' as const,
};
---

<SiteLayout seo={seo} migasOverrides={{ [`/proyectos/${proyecto.id}`]: d.cliente }}>
  <Section espaciado="amplio">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Plantilla D — Caso de estudio · se completa en Fase 5
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">{d.cliente}</h1>
    <p class="mt-2 text-[var(--color-text-muted)]">{d.sector} · {d.ciudad}</p>

    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {d.metricas.map((m) => (
        <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] p-5">
          <p class="text-[var(--text-3xl)] font-bold">{m.valor}</p>
          <p class="text-[var(--text-sm)] text-[var(--color-text-muted)]">{m.etiqueta}</p>
          <p class="mt-1 text-[var(--text-xs)] text-[var(--color-text-muted)]">Fuente: {m.fuente}</p>
        </div>
      ))}
    </div>

    <div class="prose mt-10 max-w-[42rem] text-[var(--color-text-muted)]"><Content /></div>

    <div class="mt-10"><CTA href="/cotizar" variante="primario" tamano="lg">Quiero algo así</CTA></div>
  </Section>
</SiteLayout>
