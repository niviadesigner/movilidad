---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';

const seo = {
  titulo: 'Proyectos y casos de estudio',
  descripcion:
    'Casos reales de biciparqueaderos instalados, con métricas duras de cupos, área recuperada y adopción.',
  ruta: '/proyectos',
};

const proyectos = (await getCollection('proyectos')).filter(
  (p) => import.meta.env.DEV || !p.data.borrador,
);
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      Proyectos
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Casos con métricas verificables</h1>
    <p class="mt-4 max-w-[52ch] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Prueba social para la línea de biciparqueaderos. Cada caso enlaza a los modelos que usó.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {proyectos.map((p) => (
        <Card href={`/proyectos/${p.id}`} titulo={p.data.cliente} eyebrow={`${p.data.sector} · ${p.data.ciudad}`}>
          {p.data.reto}
        </Card>
      ))}
      {proyectos.length === 0 && (
        <p class="text-[var(--text-sm)] text-[var(--color-text-muted)]">Aún no hay casos publicados.</p>
      )}
    </div>
  </Section>
</SiteLayout>
