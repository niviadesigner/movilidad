---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { HUB } from '../../data/biciparqueaderos';

const seo = {
  titulo: 'Biciparqueaderos para empresas, instituciones y conjuntos',
  descripcion:
    'Diseño, fabricación e instalación de biciparqueaderos que cumplen la Ley 1811 y el PESV. Cotiza y un ingeniero te responde en menos de 24 h.',
  ruta: '/biciparqueaderos',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...HUB} />
</SiteLayout>
