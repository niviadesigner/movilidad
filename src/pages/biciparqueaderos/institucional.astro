---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { SECTORES } from '../../data/biciparqueaderos';

const seo = {
  titulo: 'Biciparqueaderos institucionales y educativos',
  descripcion:
    'Biciparqueaderos para universidades, colegios y entidades públicas, con foco en volumen de cupos, seguridad y durabilidad.',
  ruta: '/biciparqueaderos/institucional',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...SECTORES.institucional} />
</SiteLayout>
