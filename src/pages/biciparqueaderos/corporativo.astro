---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Placeholder from '../../components/ui/Placeholder.astro';

const seo = {
  titulo: 'Biciparqueaderos corporativos',
  descripcion:
    'Biciparqueaderos para sedes empresariales: cumplimiento de PESV, recuperación de área y adopción de la bici entre colaboradores.',
  ruta: '/biciparqueaderos/corporativo',
};
---

<SiteLayout seo={seo}>
  <Placeholder
    titulo="Biciparqueaderos corporativos"
    intro="Página de sector dentro de la línea de biciparqueaderos. Habla el lenguaje de RRHH, sostenibilidad y compras."
    plantilla="A — Hub de línea"
    fase="Fase 1"
    ctaPrimario={{ label: 'Cotizar en 24 h', href: '/cotizar' }}
    relacionados={[
      { label: 'Ver modelos', href: '/biciparqueaderos/modelos' },
      { label: 'Diseño e instalación', href: '/biciparqueaderos/diseno-instalacion' },
      { label: 'Normativa: Ley 1811 y PESV', href: '/recursos/normativa' },
      { label: 'Para empresas', href: '/soluciones/empresas' },
    ]}
  />
</SiteLayout>
