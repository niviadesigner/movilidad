---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { SECTORES } from '../../data/biciparqueaderos';

const seo = {
  titulo: 'Biciparqueaderos corporativos',
  descripcion:
    'Biciparqueaderos para sedes empresariales: cumplimiento del PESV, recuperación de área y soporte al plan de movilidad.',
  ruta: '/biciparqueaderos/corporativo',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...SECTORES.corporativo} />
</SiteLayout>
