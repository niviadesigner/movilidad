---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Section from '../../../components/ui/Section.astro';
import CTA from '../../../components/ui/CTA.astro';

export async function getStaticPaths() {
  const modelos = await getCollection('modelos');
  return modelos.map((m) => ({ params: { slug: m.id }, props: { modelo: m } }));
}

const { modelo } = Astro.props;
const { Content } = await render(modelo);
const d = modelo.data;

const seo = {
  titulo: `${d.nombre} — biciparqueadero`,
  descripcion: d.resumen,
  ruta: `/biciparqueaderos/modelos/${modelo.id}`,
  noIndex: d.borrador,
  tipo: 'product' as const,
};
---

<SiteLayout seo={seo} migasOverrides={{ [`/biciparqueaderos/modelos/${modelo.id}`]: d.nombre }}>
  <Section espaciado="amplio">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Plantilla B — Ficha · se completa en Fase 1
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">{d.nombre}</h1>
    <p class="mt-2 text-[var(--color-text-muted)]">Código {d.codigo}</p>

    <dl class="mt-8 grid max-w-[40rem] gap-x-8 gap-y-3 sm:grid-cols-2">
      <div><dt class="text-[var(--text-xs)] uppercase text-[var(--color-text-muted)]">Cupos</dt><dd>{d.cupos}</dd></div>
      <div><dt class="text-[var(--text-xs)] uppercase text-[var(--color-text-muted)]">Material</dt><dd>{d.material}</dd></div>
      <div><dt class="text-[var(--text-xs)] uppercase text-[var(--color-text-muted)]">Dimensiones</dt><dd>{d.dimensiones}</dd></div>
      <div><dt class="text-[var(--text-xs)] uppercase text-[var(--color-text-muted)]">Normativa</dt><dd>{d.normativa.join(', ') || '—'}</dd></div>
    </dl>

    <div class="prose mt-8 max-w-[42rem] text-[var(--color-text-muted)]">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      <CTA href="/cotizar" variante="primario" tamano="lg">Cotizar este modelo</CTA>
      <CTA href="/biciparqueaderos/diseno-instalacion" variante="secundario">Diseño e instalación</CTA>
    </div>

    <nav aria-label="Enlaces relacionados" class="mt-14 border-t border-[var(--color-border)] pt-8 text-[var(--text-sm)]">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a class="hover:underline" href="/biciparqueaderos/modelos">Volver a modelos</a></li>
        <li><a class="hover:underline" href="/mantenimiento/flotas">Mantenimiento para flotas</a></li>
        <li><a class="hover:underline" href="/tienda/seguridad">Guayas y candados</a></li>
        <li><a class="hover:underline" href="/proyectos">Casos donde se instaló</a></li>
      </ul>
    </nav>
  </Section>
</SiteLayout>
