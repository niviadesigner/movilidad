---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import FichaModelo from '../../../components/plantillas/FichaModelo.astro';

export async function getStaticPaths() {
  const modelos = await getCollection('modelos');
  return modelos.map((m) => ({ params: { slug: m.id }, props: { modelo: m } }));
}

const { modelo } = Astro.props;
const { Content } = await render(modelo);
const d = modelo.data;

const seo = {
  titulo: `${d.nombre} — biciparqueadero (${d.codigo})`,
  descripcion: d.resumen,
  ruta: `/biciparqueaderos/modelos/${modelo.id}`,
  noIndex: d.borrador,
  tipo: 'product' as const,
};
---

<SiteLayout seo={seo} migasOverrides={{ [`/biciparqueaderos/modelos/${modelo.id}`]: d.nombre }}>
  <FichaModelo id={modelo.id} data={d}>
    <Content />
  </FichaModelo>
</SiteLayout>
