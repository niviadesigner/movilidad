---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Section from '../../../components/ui/Section.astro';
import CTA from '../../../components/ui/CTA.astro';

const seo = {
  titulo: 'Modelos de biciparqueadero',
  descripcion:
    'Compara los modelos de biciparqueadero por capacidad de cupos, material y normativa que cumplen.',
  ruta: '/biciparqueaderos/modelos',
};

const familias: Record<string, string> = {
  corporativo: 'Corporativo',
  institucional: 'Institucional y educativo',
  residencial: 'Residencial y PH',
  'mobiliario-urbano': 'Mobiliario urbano',
};

const modelos = (await getCollection('modelos'))
  .filter((m) => import.meta.env.DEV || !m.data.borrador)
  .sort((a, b) => a.data.cupos - b.data.cupos);
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      Biciparqueaderos · Modelos
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Elige por capacidad y espacio</h1>
    <p class="mt-4 max-w-[46rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Todos se fabrican en acero para intemperie y se anclan a piso. En la visita técnica
      confirmamos cuál rinde mejor en tu espacio.
    </p>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-[var(--text-sm)]">
        <thead>
          <tr class="border-b border-[var(--color-border-strong)] text-left font-mono text-[var(--text-xs)] uppercase text-[var(--color-text-muted)]">
            <th class="py-2 pr-4">Modelo</th>
            <th class="py-2 pr-4">Cupos</th>
            <th class="py-2 pr-4">Uso típico</th>
            <th class="py-2 pr-4">Material</th>
            <th class="py-2"></th>
          </tr>
        </thead>
        <tbody>
          {modelos.map((m) => (
            <tr class="border-b border-[var(--color-border)]">
              <td class="py-3 pr-4 font-semibold text-[var(--color-text)]">
                <a class="hover:underline" href={`/biciparqueaderos/modelos/${m.id}`}>{m.data.nombre}</a>
                <span class="block font-mono text-[var(--text-xs)] font-normal text-[var(--color-text-muted)]">{m.data.codigo}</span>
              </td>
              <td class="py-3 pr-4 tabular-nums">{m.data.cupos}</td>
              <td class="py-3 pr-4 text-[var(--color-text-muted)]">{familias[m.data.familia] ?? '—'}</td>
              <td class="py-3 pr-4 text-[var(--color-text-muted)]">{m.data.material}</td>
              <td class="py-3 text-right">
                <a class="font-semibold text-[var(--color-link)] hover:underline" href={`/biciparqueaderos/modelos/${m.id}`}>Ver ficha &rarr;</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {modelos.length === 0 && (
        <p class="mt-4 text-[var(--text-sm)] text-[var(--color-text-muted)]">Aún no hay modelos publicados.</p>
      )}
    </div>

    <div class="mt-12 flex flex-wrap gap-4">
      <CTA href="/cotizar" variante="primario" tamano="lg">Cotizar en 24 h</CTA>
      <CTA href="/recursos/calculadora-cupos" variante="secundario">Calcular cupos que necesito</CTA>
    </div>
  </Section>
</SiteLayout>
