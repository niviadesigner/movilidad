---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { SECTORES } from '../../data/biciparqueaderos';

const seo = {
  titulo: 'Biciparqueaderos residenciales y para PH',
  descripcion:
    'Biciparqueaderos para conjuntos residenciales y propiedad horizontal: aprovechamiento de sótanos y cumplimiento del POT.',
  ruta: '/biciparqueaderos/residencial',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...SECTORES.residencial} />
</SiteLayout>
