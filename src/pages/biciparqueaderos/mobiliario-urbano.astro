---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { SECTORES } from '../../data/biciparqueaderos';

const seo = {
  titulo: 'Mobiliario urbano para bicicletas',
  descripcion:
    'Parqueaderos y anclajes para espacio público y comercio: mobiliario urbano resistente al vandalismo y a la intemperie.',
  ruta: '/biciparqueaderos/mobiliario-urbano',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...SECTORES['mobiliario-urbano']} />
</SiteLayout>
