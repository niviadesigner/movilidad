---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { SOLUCIONES } from '../../data/soluciones';

const seo = {
  titulo: 'Soluciones de movilidad para empresas',
  descripcion:
    'Biciparqueaderos, mantenimiento en sede y accesorios por volumen: todo lo que tu empresa necesita para su plan de movilidad y el PESV.',
  ruta: '/soluciones/empresas',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...SOLUCIONES.empresas} />
</SiteLayout>
