---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { SOLUCIONES } from '../../data/soluciones';

const seo = {
  titulo: 'Soluciones de movilidad para conjuntos residenciales',
  descripcion:
    'Biciparqueaderos para propiedad horizontal: aprovecha el sótano, cumple el POT y suma un beneficio para los residentes.',
  ruta: '/soluciones/conjuntos',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...SOLUCIONES.conjuntos} />
</SiteLayout>
