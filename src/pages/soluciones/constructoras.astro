---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { SOLUCIONES } from '../../data/soluciones';

const seo = {
  titulo: 'Soluciones de movilidad para constructoras y arquitectos',
  descripcion:
    'Biciparqueaderos que cumplen el POT desde los planos: especificación técnica, modelos para sótano e instalación coordinada con obra.',
  ruta: '/soluciones/constructoras',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...SOLUCIONES.constructoras} />
</SiteLayout>
