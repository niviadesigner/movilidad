---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLinea from '../../components/plantillas/HubLinea.astro';
import { SOLUCIONES } from '../../data/soluciones';

const seo = {
  titulo: 'Soluciones de movilidad para universidades',
  descripcion:
    'Biciparqueaderos de alto volumen para campus: cupos a escala, modelos de doble altura e instalación por fases.',
  ruta: '/soluciones/universidades',
};
---

<SiteLayout seo={seo}>
  <HubLinea {...SOLUCIONES.universidades} />
</SiteLayout>
