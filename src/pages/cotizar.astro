---
import SiteLayout from '../layouts/SiteLayout.astro';
import Section from '../components/ui/Section.astro';
import FormularioCotizacion from '../components/ui/FormularioCotizacion.astro';

const seo = {
  titulo: 'Cotiza tu proyecto de biciparqueadero',
  descripcion:
    'Cuéntanos qué necesitas y un ingeniero te responde en menos de 24 h. Cinco campos, sin compromiso.',
  ruta: '/cotizar',
};
---

<SiteLayout seo={seo} sinMigas>
  <Section espaciado="amplio" ancho="estrecho">
    <h1 class="text-[var(--text-4xl)]">Cotiza y un ingeniero te responde en menos de 24 h</h1>
    <p class="mt-4 text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Cinco campos, sin compromiso. Con esto preparamos una propuesta con cupos, modelo
      sugerido y valor estimado.
    </p>

    <div class="mt-10">
      <FormularioCotizacion origen="/cotizar" idPrefijo="cot" />
    </div>
  </Section>
</SiteLayout>
