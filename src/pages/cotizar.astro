---
import SiteLayout from '../layouts/SiteLayout.astro';
import Section from '../components/ui/Section.astro';

const seo = {
  titulo: 'Cotiza tu proyecto de biciparqueadero',
  descripcion:
    'Cuéntanos qué necesitas y un ingeniero te responde en menos de 24 h. Cinco campos, sin compromiso.',
  ruta: '/cotizar',
};

// Estructura del formulario (5 campos máximo, regla §7).
// El envío real, la validación y /gracias se implementan en Fase 1.
type Campo = {
  id: string;
  label: string;
  type: 'text' | 'email' | 'tel' | 'number';
  autocomplete: string;
};
const campos: Campo[] = [
  { id: 'nombre', label: 'Nombre', type: 'text', autocomplete: 'name' },
  { id: 'empresa', label: 'Empresa', type: 'text', autocomplete: 'organization' },
  { id: 'correo', label: 'Correo', type: 'email', autocomplete: 'email' },
  { id: 'telefono', label: 'Teléfono', type: 'tel', autocomplete: 'tel' },
  { id: 'cupos', label: 'Número aproximado de cupos', type: 'number', autocomplete: 'off' },
];
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio" ancho="estrecho">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Esqueleto navegable · el envío se conecta en Fase 1
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Cotiza y un ingeniero te responde en menos de 24 h</h1>
    <p class="mt-4 text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Cinco campos, sin compromiso. Con esto preparamos una propuesta con cupos, modelo
      sugerido y valor estimado.
    </p>

    <form class="mt-10 grid gap-5" aria-describedby="cotizar-nota" method="post" action="/cotizar">
      {campos.map((c) => (
        <div class="grid gap-1.5">
          <label for={c.id} class="text-[var(--text-sm)] font-semibold">{c.label}</label>
          <input
            id={c.id}
            name={c.id}
            type={c.type}
            autocomplete={c.autocomplete}
            required
            class="h-11 rounded-[var(--radius-md)] border border-[var(--color-border-strong)] bg-[var(--color-bg)] px-3 text-[var(--text-base)]"
          />
        </div>
      ))}
      <p id="cotizar-nota" class="text-[var(--text-xs)] text-[var(--color-text-muted)]">
        Formulario no operativo en el esqueleto. La validación, el envío por n8n/correo y la
        página <a class="underline" href="/gracias">/gracias</a> se construyen en Fase 1.
      </p>
      <button
        type="submit"
        disabled
        class="inline-flex min-h-11 w-fit items-center rounded-[var(--radius-md)] bg-[var(--color-accent-500)] px-7 py-3 font-semibold text-white opacity-60"
      >
        Enviar solicitud
      </button>
    </form>
  </Section>
</SiteLayout>
