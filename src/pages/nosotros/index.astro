---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import CTA from '../../components/ui/CTA.astro';

const seo = {
  titulo: 'Nosotros',
  descripcion:
    'Quiénes somos, qué hacemos y con qué aliados y certificaciones respaldamos cada proyecto de movilidad.',
  ruta: '/nosotros',
};
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">Nosotros</p>
    <h1 class="mt-3 max-w-[26ch] text-[var(--text-4xl)]">
      Un solo proveedor para las tres líneas de la movilidad en bicicleta
    </h1>
    <p class="mt-4 max-w-[46rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Diseñamos, fabricamos e instalamos biciparqueaderos; damos mantenimiento a bicicletas; y
      vendemos los accesorios para usarla todos los días. Las tres líneas se coordinan desde el
      mismo equipo, para que un proyecto de movilidad no se reparta entre cinco proveedores.
    </p>
    <!-- TODO: reemplazar con la historia real de la empresa (fundación, trayectoria, equipo). Copy final pendiente, ver docs/copy/. -->

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <Card href="/biciparqueaderos" titulo="Biciparqueaderos">Proyecto B2B: diseño, fabricación e instalación.</Card>
      <Card href="/mantenimiento" titulo="Mantenimiento">Servicio recurrente en tres modalidades.</Card>
      <Card href="/tienda" titulo="Tienda">Accesorios con precio público y envío calculado.</Card>
    </div>
  </Section>

  <Section fondo="subtle">
    <h2 class="text-[var(--text-2xl)]">Cómo trabajamos un proyecto</h2>
    <ol class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <li class="border-t-2 border-[var(--color-primary-600)] pt-4">
        <span class="font-mono text-[var(--text-sm)] font-medium text-[var(--color-primary-600)]">01</span>
        <h3 class="mt-1 text-[var(--text-lg)] font-semibold">Nos cuentas</h3>
        <p class="mt-1.5 text-[var(--text-sm)] text-[var(--color-text-muted)]">Cotizas o agendas y nos das el contexto del espacio o el servicio.</p>
      </li>
      <li class="border-t-2 border-[var(--color-primary-600)] pt-4">
        <span class="font-mono text-[var(--text-sm)] font-medium text-[var(--color-primary-600)]">02</span>
        <h3 class="mt-1 text-[var(--text-lg)] font-semibold">Visita técnica</h3>
        <p class="mt-1.5 text-[var(--text-sm)] text-[var(--color-text-muted)]">Un ingeniero mide, evalúa y confirma lo que aplica a tu caso.</p>
      </li>
      <li class="border-t-2 border-[var(--color-primary-600)] pt-4">
        <span class="font-mono text-[var(--text-sm)] font-medium text-[var(--color-primary-600)]">03</span>
        <h3 class="mt-1 text-[var(--text-lg)] font-semibold">Propuesta</h3>
        <p class="mt-1.5 text-[var(--text-sm)] text-[var(--color-text-muted)]">Recibes alcance, modelo o plan sugerido y valor estimado por escrito.</p>
      </li>
      <li class="border-t-2 border-[var(--color-primary-600)] pt-4">
        <span class="font-mono text-[var(--text-sm)] font-medium text-[var(--color-primary-600)]">04</span>
        <h3 class="mt-1 text-[var(--text-lg)] font-semibold">Ejecución</h3>
        <p class="mt-1.5 text-[var(--text-sm)] text-[var(--color-text-muted)]">Instalamos, agendamos o despachamos, con garantía sobre lo entregado.</p>
      </li>
    </ol>
  </Section>

  <Section>
    <div class="grid gap-6 sm:grid-cols-2">
      <Card href="/nosotros/aliados" titulo="Aliados y certificaciones">
        Los proveedores y certificaciones que respaldan lo que instalamos.
      </Card>
      <Card href="/nosotros/trabaja-con-nosotros" titulo="Trabaja con nosotros">
        Vacantes y cómo dejarnos tu hoja de vida.
      </Card>
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      <CTA href="/cotizar" variante="primario" tamano="lg">Cotizar en 24 h</CTA>
      <CTA href="/proyectos" variante="secundario">Ver proyectos</CTA>
    </div>
  </Section>
</SiteLayout>
