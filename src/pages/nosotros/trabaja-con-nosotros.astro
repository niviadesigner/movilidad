---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../../components/ui/Section.astro';
import { SITE } from '../../lib/site';

const seo = {
  titulo: 'Trabaja con nosotros',
  descripcion: 'Vacantes y convocatorias del equipo de Soluciones de Movilidad.',
  ruta: '/nosotros/trabaja-con-nosotros',
};

// TODO: conectar a un listado real de vacantes cuando exista (o a un ATS externo).
const VACANTES: { cargo: string; ciudad: string }[] = [];
---

<SiteLayout seo={seo}>
  <Section espaciado="amplio">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">Nosotros · Vacantes</p>
    <h1 class="mt-3 text-[var(--text-4xl)]">Trabaja con nosotros</h1>
    <p class="mt-4 max-w-[46rem] text-[var(--text-lg)] text-[var(--color-text-muted)]">
      Instalamos infraestructura y damos mantenimiento en toda Colombia. Si eso te suena a algo
      tuyo, escríbenos aunque no haya una vacante abierta ahora mismo.
    </p>

    {VACANTES.length > 0 ? (
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {VACANTES.map((v) => (
          <li class="rounded-[var(--radius-lg)] border border-[var(--color-border)] p-5">
            <p class="font-semibold">{v.cargo}</p>
            <p class="mt-1 text-[var(--text-sm)] text-[var(--color-text-muted)]">{v.ciudad}</p>
          </li>
        ))}
      </ul>
    ) : (
      <div class="mt-10 rounded-[var(--radius-lg)] border border-dashed border-[var(--color-border-strong)] bg-[var(--color-bg-subtle)] p-6">
        <p class="text-[var(--text-base)] font-semibold">No hay vacantes abiertas por ahora.</p>
        <p class="mt-1 text-[var(--text-sm)] text-[var(--color-text-muted)]">
          Cuando abramos una convocatoria, queda listada aquí. Mientras tanto, envíanos tu hoja
          de vida a
          <a class="underline" href={`mailto:${SITE.correo}?subject=${encodeURIComponent('Hoja de vida — Trabaja con nosotros')}`}> {SITE.correo}</a>
          y la guardamos para cuando abra un cargo afín.
        </p>
      </div>
    )}
  </Section>
</SiteLayout>
