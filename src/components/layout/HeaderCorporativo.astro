---
/**
 * Header del contexto corporativo (todo el sitio menos /tienda y /mi-cuenta).
 * 5 ítems + 1 CTA primario. Fijo al hacer scroll. La tienda NO va aquí.
 */
import { NAV_CORPORATIVO, CTA_CORPORATIVO } from '../../lib/nav';
import { SITE } from '../../lib/site';
import Container from './Container.astro';
import MegaMenu from './MegaMenu.astro';
import MobileNav from './MobileNav.astro';

const aqui = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activo = (href: string) => aqui === href || aqui.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-surface)]/95 backdrop-blur">
  <Container>
    <div class="flex h-[var(--spacing-header)] items-center justify-between gap-4">
      <a href="/" class="flex items-center" aria-label={`${SITE.nombre} — inicio`}>
        <img src="/logo/logo.png" alt={SITE.nombre} width="509" height="160" class="h-12 w-auto" />
      </a>

      <nav aria-label="Principal" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {NAV_CORPORATIVO.map((item, i) => (
            <li class="group relative">
              <a
                id={`nav-${i}`}
                href={item.href}
                aria-current={activo(item.href) ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center gap-1 rounded-[var(--radius-sm)] px-3 py-2 text-[var(--text-sm)] font-medium',
                  activo(item.href)
                    ? 'text-[var(--color-primary-700)]'
                    : 'text-[var(--color-text)] hover:text-[var(--color-link-hover)]',
                ]}
              >
                {item.label}
                {item.mega && <span aria-hidden="true" class="text-[0.6em] opacity-60">&#9660;</span>}
              </a>
              {item.mega && <MegaMenu mega={item.mega} labelledby={`nav-${i}`} />}
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={CTA_CORPORATIVO.href}
          class="hidden min-h-11 items-center rounded-[var(--radius-md)] bg-[var(--color-accent-300)] px-5 py-2.5 text-[var(--text-sm)] font-semibold text-[var(--color-neutral-900)] transition-colors hover:bg-[var(--color-accent-400)] sm:inline-flex"
        >
          {CTA_CORPORATIVO.label}
        </a>
        <MobileNav />
      </div>
    </div>
  </Container>
</header>
