---
/**
 * Panel de mega menú para un ítem del header corporativo.
 * Máximo 3 columnas; cada columna cierra con una acción (docs/arquitectura §4).
 * Sin JavaScript: se abre con hover y con foco de teclado (focus-within).
 */
import type { MegaMenu } from '../../lib/nav';

interface Props {
  mega: MegaMenu;
  /** id del disparador, para aria. */
  labelledby: string;
}
const { mega, labelledby } = Astro.props;
---

<div
  role="region"
  aria-labelledby={labelledby}
  class="invisible absolute left-1/2 top-full z-40 w-[min(44rem,calc(100vw-2rem))] -translate-x-1/2 translate-y-1 opacity-0 transition-[opacity,visibility] duration-[var(--duration-base)] group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
>
  <div class="mt-2 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-md)]">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {mega.columnas.map((col) => (
        <div>
          {col.titulo && (
            <p class="mb-2 text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
              {col.titulo}
            </p>
          )}
          <ul class="space-y-1.5">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="block rounded-[var(--radius-sm)] py-1 text-[var(--text-sm)] text-[var(--color-text)] hover:text-[var(--color-link-hover)] hover:underline"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="flex items-end">
        <a
          href={mega.accion.href}
          class="inline-flex items-center gap-1 text-[var(--text-sm)] font-semibold text-[var(--color-link)] hover:text-[var(--color-link-hover)]"
        >
          {mega.accion.label}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</div>
