---
/**
 * Pie de página. 4 columnas + barra legal (docs/arquitectura §4).
 * Un solo teléfono y un solo WhatsApp en todo el sitio (regla §8).
 * Los logos de clientes NO van aquí, van en la parte alta de la home.
 */
import { FOOTER_COLUMNS, FOOTER_LEGAL } from '../../lib/nav';
import { SITE, whatsappUrl } from '../../lib/site';
import Container from './Container.astro';

const anio = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-neutral-950)] text-[var(--color-neutral-300)]">
  <Container>
    <div class="grid gap-8 py-14 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-1">
        <p class="font-bold text-white">{SITE.nombre}</p>
        <p class="mt-2 text-[var(--text-sm)] text-[var(--color-neutral-400)]">
          Infraestructura y servicios para movilidad en bicicleta.
        </p>
        <div class="mt-4 space-y-1 text-[var(--text-sm)]">
          <p>
            Tel: <a href={`tel:${SITE.tel.replace(/\s+/g, '')}`} class="hover:text-white">{SITE.tel}</a>
          </p>
          <p>
            <a href={whatsappUrl()} rel="noopener noreferrer" target="_blank" class="hover:text-white">WhatsApp</a>
          </p>
          <p>
            <a href={`mailto:${SITE.correo}`} class="hover:text-white">{SITE.correo}</a>
          </p>
        </div>
      </div>

      {FOOTER_COLUMNS.map((col) => (
        <nav aria-label={col.titulo}>
          <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-neutral-500)]">
            {col.titulo}
          </p>
          <ul class="mt-3 space-y-2 text-[var(--text-sm)]">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-white hover:underline">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="flex flex-col gap-3 border-t border-[var(--color-neutral-800)] py-6 text-[var(--text-xs)] text-[var(--color-neutral-500)] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {anio} {SITE.nombreLegal}. Todos los derechos reservados.</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {FOOTER_LEGAL.map((l) => (
          <li><a href={l.href} class="hover:text-white hover:underline">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </Container>
</footer>
