---
/**
 * PLANTILLA A — Hub de línea (docs/CLAUDE.md §6).
 * Orden fijo: encabezado con dolor + CTA · selector de sector/categoría ·
 * cómo funciona · prueba social · venta cruzada · FAQ · CTA de cierre.
 *
 * Todas las secciones salvo el encabezado son opcionales, para que las
 * páginas de sector reutilicen un subconjunto.
 */
import Section from '../ui/Section.astro';
import CTA from '../ui/CTA.astro';
import Card from '../ui/Card.astro';
import Pasos from '../ui/Pasos.astro';
import VentaCruzada from '../ui/VentaCruzada.astro';
import LogoBar from '../ui/LogoBar.astro';
import FAQ from '../ui/FAQ.astro';
import type { Paso } from '../ui/Pasos.astro';
import type { ItemCruzada } from '../ui/VentaCruzada.astro';
import type { ItemFAQ } from '../ui/FAQ.astro';
import Icono, { type NombreIcono } from '../ui/Icono.astro';

interface EnlaceCTA {
  label: string;
  href: string;
}
interface TarjetaSelector {
  titulo: string;
  texto: string;
  href: string;
  icono?: NombreIcono;
}
interface CasoDestacado {
  cliente: string;
  resumen: string;
  cifras: { valor: string; etiqueta: string; fuente: string }[];
  href: string;
}

interface Props {
  eyebrow?: string;
  titulo: string;
  /** El "dolor" de la línea, 2-3 líneas. */
  intro: string;
  ctaPrimario: EnlaceCTA;
  ctaSecundario?: EnlaceCTA;
  imagenHero?: { src?: string; alt: string; icono?: NombreIcono };

  selector?: { titulo: string; items: TarjetaSelector[] };
  pasos?: { titulo?: string; items: Paso[] };
  logos?: { titulo?: string; items?: { nombre: string; src?: string }[] };
  caso?: CasoDestacado;
  ventaCruzada?: { titulo?: string; items: ItemCruzada[] };
  faq?: { titulo?: string; items: ItemFAQ[] };
  cierre?: { titulo: string; texto: string; cta: EnlaceCTA };
}

const {
  eyebrow,
  titulo,
  intro,
  ctaPrimario,
  ctaSecundario,
  imagenHero,
  selector,
  pasos,
  logos,
  caso,
  ventaCruzada,
  faq,
  cierre,
} = Astro.props;
---

<!-- Encabezado con el dolor + CTA -->
<Section fondo="subtle" espaciado="amplio">
  <div class:list={['grid items-center gap-10', imagenHero && 'lg:grid-cols-[minmax(0,46rem)_1fr]']}>
    <div>
      {eyebrow && (
        <p class="font-mono text-[var(--text-xs)] font-medium uppercase tracking-wide text-[var(--color-text-muted)]">
          {eyebrow}
        </p>
      )}
      <h1 class="mt-3 text-[var(--text-4xl)]">{titulo}</h1>
      <p class="mt-4 text-[var(--text-lg)] text-[var(--color-text-muted)]">{intro}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <CTA href={ctaPrimario.href} variante="primario" tamano="lg">{ctaPrimario.label}</CTA>
        {ctaSecundario && (
          <CTA href={ctaSecundario.href} variante="secundario">{ctaSecundario.label}</CTA>
        )}
      </div>
    </div>
    {imagenHero && (imagenHero.src ? (
      <img
        src={imagenHero.src}
        alt={imagenHero.alt}
        width="900"
        height="675"
        fetchpriority="high"
        decoding="async"
        class="hidden w-full rounded-[var(--radius-lg)] object-cover lg:block"
      />
    ) : (
      <div class="hidden aspect-[4/3] w-full flex-col items-center justify-center gap-3 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-primary-50)] text-[var(--color-primary-700)] lg:flex">
        <Icono nombre={imagenHero.icono ?? 'bici'} class="h-16 w-16" />
        <p class="text-[var(--text-sm)] font-medium">Foto o render pendiente</p>
      </div>
    ))}
  </div>
</Section>

{selector && (
  <Section>
    <h2 class="text-[var(--text-2xl)]">{selector.titulo}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {selector.items.map((it) => (
        <Card href={it.href} titulo={it.titulo} icono={it.icono}>{it.texto}</Card>
      ))}
    </div>
  </Section>
)}

{pasos && (
  <Section fondo="subtle">
    <Pasos titulo={pasos.titulo} pasos={pasos.items} />
  </Section>
)}

{(logos || caso) && (
  <Section>
    {logos && <LogoBar titulo={logos.titulo} logos={logos.items} />}
    {caso && (
      <div class:list={['rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8', logos && 'mt-10']}>
        <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
          Caso destacado
        </p>
        <p class="mt-2 text-[var(--text-lg)] font-semibold">{caso.cliente}</p>
        <p class="mt-1 text-[var(--text-sm)] text-[var(--color-text-muted)]">{caso.resumen}</p>
        <dl class="mt-6 grid gap-6 sm:grid-cols-3">
          {caso.cifras.map((c) => (
            <div>
              <dt class="sr-only">{c.etiqueta}</dt>
              <dd class="text-[var(--text-3xl)] font-bold text-[var(--color-primary-700)]">{c.valor}</dd>
              <p class="text-[var(--text-sm)] text-[var(--color-text-muted)]">{c.etiqueta}</p>
              <p class="mt-0.5 text-[var(--text-xs)] text-[var(--color-text-muted)]">Fuente: {c.fuente}</p>
            </div>
          ))}
        </dl>
        <a href={caso.href} class="mt-6 inline-block text-[var(--text-sm)] font-semibold text-[var(--color-link)] hover:underline">
          Ver el caso completo &rarr;
        </a>
      </div>
    )}
  </Section>
)}

{ventaCruzada && (
  <Section fondo="subtle">
    <VentaCruzada titulo={ventaCruzada.titulo} items={ventaCruzada.items} />
  </Section>
)}

{faq && (
  <Section>
    <FAQ titulo={faq.titulo} items={faq.items} />
  </Section>
)}

{cierre && (
  <Section fondo="primario" espaciado="amplio">
    <div class="max-w-[42rem]">
      <h2 class="text-[var(--text-3xl)] text-[var(--color-text-inverse)]">{cierre.titulo}</h2>
      <p class="mt-3 text-[var(--color-primary-100)]">{cierre.texto}</p>
      <div class="mt-8">
        <CTA href={cierre.cta.href} variante="primario" tamano="lg">{cierre.cta.label}</CTA>
      </div>
    </div>
  </Section>
)}
