---
/**
 * PLANTILLA C — Servicio agendable (docs/CLAUDE.md §6).
 * Qué incluye · para quién · comparativo de planes (enlace) · tiempos ·
 * cobertura · agendador (CTA) · FAQ.
 */
import Section from '../ui/Section.astro';
import CTA from '../ui/CTA.astro';
import FAQ from '../ui/FAQ.astro';
import Pasos from '../ui/Pasos.astro';
import type { ContenidoServicio } from '../../data/mantenimiento';

interface Props {
  contenido: ContenidoServicio;
}
const c = Astro.props.contenido;
---

<Section fondo="subtle" espaciado="amplio">
  <div class="max-w-[46rem]">
    <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      {c.eyebrow}
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">{c.titulo}</h1>
    <p class="mt-4 text-[var(--text-lg)] text-[var(--color-text-muted)]">{c.intro}</p>

    {c.aviso && (
      <p class="mt-5 rounded-[var(--radius-md)] border-l-4 border-[var(--color-primary-600)] bg-[var(--color-surface)] px-4 py-3 text-[var(--text-sm)] font-medium">
        {c.aviso}
      </p>
    )}

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <CTA href={c.cta.href} variante="primario" tamano="lg">{c.cta.label}</CTA>
      {c.ctaSecundario && (
        <CTA href={c.ctaSecundario.href} variante="secundario">{c.ctaSecundario.label}</CTA>
      )}
    </div>
  </div>
</Section>

<Section>
  <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <h2 class="text-[var(--text-2xl)]">Qué incluye</h2>
      <ul class="mt-5 grid gap-2">
        {c.incluye.map((i) => (
          <li class="flex gap-3 text-[var(--text-sm)] text-[var(--color-text-muted)]">
            <span aria-hidden="true" class="font-semibold text-[var(--color-primary-600)]">+</span>
            {i}
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] p-6">
      <h2 class="text-[var(--text-lg)] font-semibold">Para quién</h2>
      <p class="mt-2 text-[var(--text-sm)] text-[var(--color-text-muted)]">{c.paraQuien}</p>
      <h2 class="mt-6 text-[var(--text-lg)] font-semibold">Tiempos</h2>
      <p class="mt-2 text-[var(--text-sm)] text-[var(--color-text-muted)]">{c.tiempos}</p>
      <a href="/mantenimiento/planes" class="mt-6 inline-block text-[var(--text-sm)] font-semibold text-[var(--color-link)] hover:underline">
        Ver comparativo de planes &rarr;
      </a>
    </div>
  </div>
</Section>

{c.pasos && (
  <Section fondo="subtle">
    <Pasos titulo="Cómo se agenda" pasos={c.pasos} />
  </Section>
)}

<Section>
  <FAQ titulo="Preguntas frecuentes" items={c.faq} />
</Section>

<Section fondo="primario" espaciado="amplio">
  <div class="max-w-[42rem]">
    <h2 class="text-[var(--text-3xl)] text-[var(--color-text-inverse)]">¿Listo para agendar?</h2>
    <p class="mt-3 text-[var(--color-primary-100)]">
      Eliges la modalidad, das los datos de esa ruta y confirmas.
    </p>
    <div class="mt-8">
      <CTA href={c.cta.href} variante="primario" tamano="lg">{c.cta.label}</CTA>
    </div>
  </div>
</Section>
