---
/**
 * PLANTILLA D — Caso de estudio (docs/CLAUDE.md §6).
 * Cliente y sector · reto · solución instalada · 3 métricas duras ·
 * testimonio · productos usados con enlace a ficha · CTA "quiero algo así".
 */
import CTA from '../ui/CTA.astro';

interface Metrica {
  valor: string;
  etiqueta: string;
  fuente: string;
}
interface ModeloUsado {
  id: string;
  nombre: string;
}
interface Props {
  cliente: string;
  sector: string;
  ciudad: string;
  reto: string;
  solucion: string;
  metricas: Metrica[];
  testimonio?: { cita: string; autor: string; cargo: string };
  modelosUsados: ModeloUsado[];
}
const { cliente, sector, ciudad, reto, solucion, metricas, testimonio, modelosUsados } = Astro.props;
---

<div class="max-w-[46rem]">
  <p class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
    Caso de estudio · {sector} · {ciudad}
  </p>
  <h1 class="mt-3 text-[var(--text-4xl)]">{cliente}</h1>
</div>

<div class="mt-8 grid gap-6 sm:grid-cols-2">
  <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] p-6">
    <h2 class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">El reto</h2>
    <p class="mt-2 text-[var(--color-text)]">{reto}</p>
  </div>
  <div class="rounded-[var(--radius-lg)] border border-[var(--color-primary-200)] bg-[var(--color-primary-50)] p-6">
    <h2 class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-primary-700)]">La solución</h2>
    <p class="mt-2 text-[var(--color-text)]">{solucion}</p>
  </div>
</div>

<dl class="mt-10 grid gap-6 sm:grid-cols-3">
  {metricas.map((m) => (
    <div>
      <dt class="sr-only">{m.etiqueta}</dt>
      <dd class="text-[var(--text-3xl)] font-bold text-[var(--color-primary-700)]">{m.valor}</dd>
      <p class="mt-1 text-[var(--text-sm)] text-[var(--color-text-muted)]">{m.etiqueta}</p>
      <p class="mt-0.5 font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]">Fuente: {m.fuente}</p>
    </div>
  ))}
</dl>

<div class="prose mt-10 max-w-[42rem] text-[var(--color-text-muted)]">
  <slot />
</div>

{testimonio && (
  <blockquote class="mt-10 max-w-[42rem] border-l-4 border-[var(--color-primary-600)] pl-6">
    <p class="text-[var(--text-lg)] italic text-[var(--color-text)]">"{testimonio.cita}"</p>
    <footer class="mt-3 text-[var(--text-sm)] text-[var(--color-text-muted)]">
      {testimonio.autor} · {testimonio.cargo}
    </footer>
  </blockquote>
)}

{modelosUsados.length > 0 && (
  <div class="mt-10">
    <h2 class="font-mono text-[var(--text-xs)] uppercase tracking-wide text-[var(--color-text-muted)]">
      Modelos usados en este proyecto
    </h2>
    <ul class="mt-3 flex flex-wrap gap-3">
      {modelosUsados.map((m) => (
        <li>
          <a
            href={`/biciparqueaderos/modelos/${m.id}`}
            class="inline-block rounded-[var(--radius-md)] border border-[var(--color-border)] px-4 py-2 text-[var(--text-sm)] font-semibold hover:border-[var(--color-primary-400)]"
          >
            {m.nombre} &rarr;
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<div class="mt-12">
  <CTA href="/cotizar" variante="primario" tamano="lg">Quiero algo así</CTA>
</div>
