---
/**
 * Bloque de página en esqueleto (Fase 0).
 * Da a cada ruta un <h1> único, una intención declarada, la plantilla que le
 * tocará y enlaces internos para que ninguna página quede huérfana.
 *
 * Se retira a medida que cada fase llena la página con contenido real.
 */
import Section from './Section.astro';
import CTA from './CTA.astro';

export interface EnlaceRelacionado {
  label: string;
  href: string;
}

interface Props {
  titulo: string;
  intro: string;
  /** Plantilla de docs/CLAUDE.md §6 que aplicará esta página. */
  plantilla?: 'A — Hub de línea' | 'B — Ficha' | 'C — Servicio agendable' | 'D — Caso de estudio' | 'Especial';
  /** Fase del plan en la que se construye de verdad. */
  fase: string;
  ctaPrimario?: EnlaceRelacionado;
  ctaSecundario?: EnlaceRelacionado;
  relacionados?: EnlaceRelacionado[];
}
const { titulo, intro, plantilla, fase, ctaPrimario, ctaSecundario, relacionados = [] } = Astro.props;
---

<Section espaciado="amplio">
  <div class="max-w-[42rem]">
    <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      Esqueleto navegable · se completa en {fase}
    </p>
    <h1 class="mt-3 text-[var(--text-4xl)]">{titulo}</h1>
    <p class="mt-4 text-[var(--text-lg)] text-[var(--color-text-muted)]">{intro}</p>

    {plantilla && (
      <p class="mt-4 inline-block rounded-[var(--radius-sm)] bg-[var(--color-bg-muted)] px-2.5 py-1 text-[var(--text-xs)] text-[var(--color-text-muted)]">
        Plantilla {plantilla}
      </p>
    )}

    {(ctaPrimario || ctaSecundario) && (
      <div class="mt-8 flex flex-wrap items-center gap-4">
        {ctaPrimario && (
          <CTA href={ctaPrimario.href} variante="primario" tamano="lg">{ctaPrimario.label}</CTA>
        )}
        {ctaSecundario && (
          <CTA href={ctaSecundario.href} variante="secundario">{ctaSecundario.label}</CTA>
        )}
      </div>
    )}
  </div>

  {relacionados.length > 0 && (
    <nav aria-label="Enlaces relacionados" class="mt-14 border-t border-[var(--color-border)] pt-8">
      <p class="text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
        Continuar hacia
      </p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {relacionados.map((r) => (
          <li>
            <a
              href={r.href}
              class="flex items-center justify-between gap-2 rounded-[var(--radius-md)] border border-[var(--color-border)] px-4 py-3 text-[var(--text-sm)] hover:border-[var(--color-primary-400)]"
            >
              {r.label}
              <span aria-hidden="true" class="text-[var(--color-text-muted)]">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <slot />
</Section>
