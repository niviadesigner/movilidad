---
/**
 * Aviso fijo en las 3 páginas legales: son un borrador con estructura completa
 * y citas normativas correctas, pero deben pasar por el abogado del cliente
 * antes de considerarse el texto definitivo y vinculante.
 */
interface Props {
  actualizado: string;
}
const { actualizado } = Astro.props;
---

<div class="mb-8 rounded-[var(--radius-md)] border-l-4 border-[var(--color-warning-500)] bg-[var(--color-warning-50)] px-4 py-3 text-[var(--text-sm)]">
  <p class="font-semibold text-[var(--color-text)]">Borrador pendiente de revisión legal</p>
  <p class="mt-1 text-[var(--color-text-muted)]">
    Este texto sigue la estructura y las normas aplicables en Colombia, pero no reemplaza la
    revisión de un abogado antes de publicarse como versión definitiva.
  </p>
  <p class="mt-2 font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]">
    Última actualización: {actualizado}
  </p>
</div>
