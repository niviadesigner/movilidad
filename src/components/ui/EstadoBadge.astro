---
/**
 * Estado de una línea o producto: nunca se muestra como disponible algo que
 * todavía está en desarrollo (brief del cliente, §7).
 */
interface Props {
  estado: 'disponible' | 'proximamente' | 'desarrollo';
}
const { estado } = Astro.props;

const ETIQUETAS = {
  disponible: { texto: 'Disponible ahora', clase: 'bg-[var(--color-success-50)] text-[var(--color-success-500)]' },
  proximamente: { texto: 'Próximamente', clase: 'bg-[var(--color-accent-100)] text-[var(--color-neutral-900)]' },
  desarrollo: { texto: 'En desarrollo', clase: 'bg-[var(--color-bg-muted)] text-[var(--color-text-muted)]' },
} as const;
const e = ETIQUETAS[estado];
---

<span class:list={['inline-block rounded-[var(--radius-sm)] px-2 py-0.5 font-mono text-[var(--text-xs)] font-medium uppercase tracking-wide', e.clase]}>
  {e.texto}
</span>
