---
/**
 * Tarjeta base: sector, modelo, producto, caso de estudio, recurso.
 * Si recibe `href`, toda la tarjeta es clicable (con foco accesible).
 */
interface Props {
  href?: string;
  titulo?: string;
  eyebrow?: string;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { href, titulo, eyebrow, as = 'article', class: clase = '' } = Astro.props;
const Tag = as;

const base =
  'group relative flex flex-col rounded-[var(--radius-lg)] border border-[var(--color-border)] ' +
  'bg-[var(--color-surface)] p-6 transition-shadow duration-[var(--duration-base)] ' +
  'hover:shadow-[var(--shadow-md)]';
---

<Tag class:list={[base, clase]}>
  {eyebrow && (
    <p class="mb-1 text-[var(--text-xs)] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
      {eyebrow}
    </p>
  )}
  {titulo && (
    <h3 class="text-[var(--text-lg)] font-bold">
      {href ? (
        <a href={href} class="after:absolute after:inset-0 after:content-['']">
          {titulo}
        </a>
      ) : (
        titulo
      )}
    </h3>
  )}
  <div class="mt-2 text-[var(--text-sm)] text-[var(--color-text-muted)]">
    <slot />
  </div>
</Tag>
