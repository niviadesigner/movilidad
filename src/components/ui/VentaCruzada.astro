---
/**
 * Bloque de venta cruzada a las otras líneas.
 * Es el negocio real: quien compra un biciparqueadero necesita candados y
 * mantenimiento (docs/arquitectura §2).
 */
export interface ItemCruzada {
  label: string;
  texto: string;
  href: string;
}
interface Props {
  titulo?: string;
  items: ItemCruzada[];
}
const { titulo = 'Esto también te va a servir', items } = Astro.props;
---

<div>
  {titulo && <h2 class="text-[var(--text-2xl)]">{titulo}</h2>}
  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((i) => (
      <li>
        <a
          href={i.href}
          class="flex h-full flex-col rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-colors hover:border-[var(--color-primary-400)]"
        >
          <span class="text-[var(--text-base)] font-semibold text-[var(--color-primary-700)]">{i.label}</span>
          <span class="mt-1.5 text-[var(--text-sm)] text-[var(--color-text-muted)]">{i.texto}</span>
          <span class="mt-3 text-[var(--text-sm)] font-medium text-[var(--color-link)]" aria-hidden="true">Ver más &rarr;</span>
        </a>
      </li>
    ))}
  </ul>
</div>
