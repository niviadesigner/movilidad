# Copia este archivo a .env y rellena los valores reales. NUNCA subas .env al repo.

# --- Supabase (leads y pedidos) ---
# Estos tres los inyecta solo la integración nativa de Vercel + Supabase.
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="TU_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="TU_SECRET_KEY"

# --- Wompi (pasarela de pago de la tienda) ---
# TODO: reemplazar con llaves reales. En Fase 0 no se usan.
PUBLIC_WOMPI_PUBLIC_KEY="pub_test_XXXX"
WOMPI_PRIVATE_KEY="prv_test_XXXX"
WOMPI_EVENTS_SECRET="XXXX"
WOMPI_INTEGRITY_SECRET="XXXX"

# --- Contacto único del sitio (regla de credibilidad §8) ---
# Valor por defecto ya definido en src/lib/site.ts; estas variables solo lo sobrescriben.
PUBLIC_TEL="+57 305 713 4994"
PUBLIC_WHATSAPP="573057134994"

# --- Notificaciones (n8n / correo) ---
N8N_WEBHOOK_COTIZACIONES=""
N8N_WEBHOOK_AGENDAMIENTOS=""

# --- Analítica (Fase 6) ---
# Vacío por defecto: sin esto, el sitio no carga ningún script de analítica.
# Elección por defecto: Google Analytics 4. Cámbiala si prefieren otra herramienta.
PUBLIC_GA4_ID=""
